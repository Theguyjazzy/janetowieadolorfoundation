<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Route legacy .html paths through the redesigned SPA even if old files remain
  RewriteRule ^(admin|stories|founders|get-involved|donate|post|story-[a-z-]+)\.html$ /index.html [L]

  # Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback for /stories, /admin, /donate, /founders, /get-involved, etc.
  RewriteRule ^ /index.html [L]
</IfModule>
